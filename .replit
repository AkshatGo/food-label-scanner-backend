entrypoint = "app/main.py"
modules = ["python-3.11"]
run = "python -m uvicorn app.main:app --host 0.0.0.0 --port 8080 --workers 1"

[deployment]
build = ["sh", "-c", "pip install -r requirements.lock && python scripts/build_icons.py"]
run = ["sh", "-c", "APP_ENV=production python -m uvicorn app.main:app --host 0.0.0.0 --port 8080 --workers 1"]
deploymentTarget = "vm"

[[ports]]
localPort = 8080
externalPort = 80

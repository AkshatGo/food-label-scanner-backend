# LabelLens backend environment (copy to .env and adjust)
# Storage: leave MONGODB_URI empty to use the built-in in-memory store (dev only).
MONGODB_URI=
DATABASE_NAME=labelens

# Auth
# HS256 requires a secret of at least 32 bytes.
JWT_SECRET=change-me-this-must-be-at-least-32-bytes-long
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# CORS
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://localhost:5173

# OCR quality gate: below this average confidence a scan is flagged needs_review
LOW_OCR_CONFIDENCE_THRESHOLD=55
